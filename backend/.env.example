# ── Server ─────────────────────────────────────────────
PORT=8000
NODE_ENV=development          # set to "production" in prod

# ── Database ───────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/jobhunt

# ── Auth / JWT ─────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SECRET_KEY=REPLACE_WITH_A_STRONG_RANDOM_64_CHAR_HEX_SECRET
REFRESH_TOKEN_SECRET=REPLACE_WITH_ANOTHER_STRONG_64_CHAR_HEX_SECRET

# ── Google OAuth ────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id_here

# ── CORS & Client URL ──────────────────────────────────
CLIENT_URL=http://localhost:3000

# ── Cloudinary File Storage (Phase 3) ──────────────────
# Create free account at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Email Service (Phase 4: Nodemailer / SMTP) ─────────
# Leave blank to use console logger in development
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM="Job Hunt" <no-reply@jobhunt.io>
